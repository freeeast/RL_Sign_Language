+                    print(f"[MotionLib] failed to load {pkl_file}: {e}")
+            if not loaded:
+                # Upstream built the cache on cpu and then called exit(), so the first
+                # run always terminated. Build on cpu, save, then reload on the target device.
+                print("No valid pkl file found, loading from yaml (on cpu)")
                 self._device = "cpu"
                 self._load_motions(motion_file, no_keybody)
                 self.serialize_motions(pkl_file)
+                self._device = device
+                self.deserialize_motions(pkl_file)
         else:
