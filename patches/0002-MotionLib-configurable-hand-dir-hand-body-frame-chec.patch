+    def _pkl_matches_yaml(self, motion_file):
+        motion_files = self._fetch_motion_files(motion_file)[0]
+        return [os.path.normpath(f) for f in motion_files] == [os.path.normpath(f) for f in self._motion_files]
+
+    def _resolve_hand_dir(self, motion_file):
+        """Where '<motion>_hand_full_pose.npy' files live. Priority:
+        1. top-level `hand_root` key in the motion yaml (relative paths are relative to the yaml)
+        2. env var SIGNBOT_HAND_DIR
+        3. <motions.root>/../target_linker_hand
+        """
+        if os.path.splitext(motion_file)[1] == ".yaml":
+            with open(motion_file, 'r') as f:
+                cfg = yaml.load(f, Loader=yaml.SafeLoader)
+            if cfg.get("hand_root"):
+                return os.path.normpath(os.path.join(os.path.dirname(motion_file), cfg["hand_root"]))
+            if os.environ.get("SIGNBOT_HAND_DIR"):
+                return os.environ["SIGNBOT_HAND_DIR"]
+            body_root = os.path.join(os.path.dirname(motion_file), cfg["motions"]["root"])
+            return os.path.normpath(os.path.join(body_root, "..", "target_linker_hand"))
+        if os.environ.get("SIGNBOT_HAND_DIR"):
+            return os.environ["SIGNBOT_HAND_DIR"]
+        return os.path.normpath(os.path.join(os.path.dirname(motion_file), "..", "target_linker_hand"))
+
     def _fetch_motion_files(self, motion_file):
         ext = os.path.splitext(motion_file)[1]
         if (ext == ".yaml"):
