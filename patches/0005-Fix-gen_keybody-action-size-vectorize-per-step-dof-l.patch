+def load_clip_file(path):
+    """One pkl containing a whole clip (arrays of shape (T, ...))."""
+    clip = os.path.splitext(os.path.basename(path))[0]
+    d = _load_pkl(path)
+    T = _num_frames_in(d)
+
+    def arr(key, n, required=True):
+        if key not in d:
+            if required:
+                raise KeyError(key)
+            return np.zeros((T, n), dtype=np.float32)
+        a = np.asarray(d[key], dtype=np.float32).reshape(T, -1)
+        if a.shape[1] < n:
+            raise ValueError(f"{key} has shape {a.shape}, expected (T, {n})")
+        return a[:, :n]
+    betas = arr("smplx_shape", 10) if np.asarray(d["smplx_shape"]).size >= 10 * T \
