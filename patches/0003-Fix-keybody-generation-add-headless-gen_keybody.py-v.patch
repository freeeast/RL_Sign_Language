index 0000000..20f4480
--- /dev/null
+++ b/legged_gym/legged_gym/scripts/gen_keybody.py
@@ -0,0 +1,58 @@
+"""Generate <motion>_key_bodies.npy for every motion of a yaml (headless).
+
+Replaces the upstream README step
+    python train.py debug --task h1_view ... --debug   (train 1 iter, kill it)
+    python play.py debug --task h1_view ...
+which needed a dummy checkpoint only to step the env. Here the h1_view env is
+stepped with zero actions: it kinematically replays every motion (one env per
+motion), records local key-body positions and writes
+os.path.splitext(<motion npy>)[0] + "_key_bodies.npy", then exits.
+
+Usage (from legged_gym/legged_gym/scripts):
+    python gen_keybody.py --motion_name motions_how2sign_val.yaml
+"""
+import sys
+
+# get_args() has a required positional `exptid`; it is meaningless here.
+if len(sys.argv) < 2 or sys.argv[1].startswith("-"):
+    sys.argv.insert(1, "gen_keybody")
+
+import isaacgym  # noqa: F401  (must be imported before torch)
+from legged_gym.envs import *  # noqa: F401,F403
+from legged_gym.utils import get_args, task_registry
+import torch
+
+
+def main():
+    args = get_args()
+    args.task = "h1_view"
+    args.headless = True
+    if args.motion_name is not None and args.motion_type is None:
+        args.motion_type = "yaml" if args.motion_name.endswith(".yaml") else "single"
+
+    env_cfg, _ = task_registry.get_cfgs(name=args.task)
+    if args.motion_name is not None:
+        env_cfg.motion.motion_name = args.motion_name
+    if args.motion_type is not None:
+        env_cfg.motion.motion_type = args.motion_type
+    # replay only: no noise / randomization, flat-ish ground
+    env_cfg.noise.add_noise = False
+    env_cfg.domain_rand.push_robots = False
+    env_cfg.domain_rand.randomize_gravity = False
+    env_cfg.terrain.curriculum = False
+    env_cfg.terrain.num_rows = 5
+    env_cfg.terrain.num_cols = 5
+
+    env, _ = task_registry.make_env(name=args.task, args=args, env_cfg=env_cfg)
+    print(f"[gen_keybody] replaying {env.num_envs} motions from {env_cfg.motion.motion_name}")
+    actions = torch.zeros(env.num_envs, env.num_actions, device=env.device)
+    max_steps = int(env._motion_lib.get_motion_num_frames(env._motion_ids).max().item()) + 10
+    with torch.no_grad():
+        for _ in range(max_steps):
+            env.step(actions)  # the env calls sys.exit(0) once every motion is saved
+    print("[gen_keybody] finished without saving every motion, check the log above")
+    sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
