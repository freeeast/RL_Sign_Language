+"""Step 3b of the data pipeline: human hand joints -> Linker hand joint angles.
+
+Replaces the dex-retargeting half of upstream
+`dex-retargeting/example/data_process_hand.py` (same vector retargeting, same
+hand alignment). Run it in the separate *dexret* conda env (dex_retargeting +
+pinocchio + nlopt; no smplx / isaacgym needed).
+
+Input : <in_root>/hand_joints/<clip>.npz            (tools/prepare_smplx_poses.py)
+Output: <out_dir>/<clip>_hand_full_pose.npy          (T, 30) = [left 15 | right 15]
+
+Example:
+  python tools/retarget_hands.py --in_root /root/autodl-tmp/data/how2sign \
+      --out_dir /root/autodl-tmp/data/how2sign/target_linker_hand \
+      --urdf_dir /root/autodl-tmp/Signbot/body_models/hands --workers 8
+"""
+import argparse
+import multiprocessing as mp
+import os
+import sys
+
+import numpy as np
+
+
+# ---- alignment helpers, copied from upstream data_process_hand.py ----------
+def normalize(v):
+    return v / np.linalg.norm(v)
+
+
+def calculate_rotation_matrix_to_target(source_vector, target_vector):
+    source_vector = normalize(source_vector)
+    target_vector = normalize(target_vector)
+    cross_prod = np.cross(source_vector, target_vector)
+    dot_prod = np.dot(source_vector, target_vector)
+    if np.linalg.norm(cross_prod) < 1e-6:
+        return np.eye(3)
+    k = np.array([[0, -cross_prod[2], cross_prod[1]],
+                  [cross_prod[2], 0, -cross_prod[0]],
+                  [-cross_prod[1], cross_prod[0], 0]])
+    return np.eye(3) + k + k @ k * ((1 - dot_prod) / (np.linalg.norm(cross_prod) ** 2))
+
+
+def align_09_to_z_axis(global_coords):
+    """Rotate so that wrist(0)->middle MCP(9) points along +z."""
+    rot = calculate_rotation_matrix_to_target(global_coords[9] - global_coords[0], np.array([0, 0, 1]))
+    return (rot @ global_coords.T).T
+
+
+def rotate_based_on_joint_distribution(global_coords):
+    """Rotate about z so the xy projection of joint 0 -> joint 11 lies on +x."""
+    v = global_coords[11, :2] - global_coords[0, :2]
+    a = -np.arctan2(v[1], v[0])
+    rot = np.array([[np.cos(a), -np.sin(a)], [np.sin(a), np.cos(a)]])
+    global_coords = global_coords.copy()
+    global_coords[:, :2] = (rot @ global_coords[:, :2].T).T
+    return global_coords
+
+
+# ------------------------------------------------------------------------------
+_URDF_DIR = None
+
+
+def _init(urdf_dir):
+    global _URDF_DIR
+    _URDF_DIR = urdf_dir
+    os.environ.setdefault("OMP_NUM_THREADS", "1")
+
+
+def _build(hand):
+    from dex_retargeting.constants import RobotName, RetargetingType, HandType, get_default_config_path
+    from dex_retargeting.retargeting_config import RetargetingConfig
+    RetargetingConfig.set_default_urdf_dir(str(_URDF_DIR))
+    ht = HandType.left if hand == "left" else HandType.right
+    path = get_default_config_path(RobotName.linker, RetargetingType.vector, ht)
+    return RetargetingConfig.load_from_file(path).build()
+
+
+def _retarget_seq(joints, hand):
+    retargeting = _build(hand)  # fresh low-pass filter state per clip (as upstream)
+    idx = retargeting.optimizer.target_link_human_indices
+    origin_idx, task_idx = idx[0, :], idx[1, :]
+    out = []
+    for frame in joints:
+        tmp = rotate_based_on_joint_distribution(align_09_to_z_axis(frame))
+        out.append(retargeting.retarget(tmp[task_idx, :] - tmp[origin_idx, :]))
+    return np.asarray(out, dtype=np.float32)
+
+
+def _work(job):
+    src, dst = job
+    try:
+        d = np.load(src)
+        left = _retarget_seq(d["left"], "left")
+        right = _retarget_seq(d["right"], "right")
+        np.save(dst, np.concatenate([left, right], axis=1))
+        return None
+    except Exception as e:
+        return f"{src}: {type(e).__name__}: {e}"
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--in_root", required=True, help="out_root of prepare_smplx_poses.py (contains hand_joints/)")
+    ap.add_argument("--out_dir", required=True)
+    ap.add_argument("--urdf_dir", required=True, help="Signbot/body_models/hands")
+    ap.add_argument("--workers", type=int, default=min(8, len(os.sched_getaffinity(0))))
+    ap.add_argument("--overwrite", action="store_true")
+    args = ap.parse_args()
+
+    hand_dir = os.path.join(args.in_root, "hand_joints")
+    os.makedirs(args.out_dir, exist_ok=True)
+    jobs = []
+    for f in sorted(os.listdir(hand_dir)):
+        if not f.endswith(".npz"):
+            continue
+        dst = os.path.join(args.out_dir, f[:-4] + "_hand_full_pose.npy")
+        if os.path.exists(dst) and not args.overwrite:
+            continue
+        jobs.append((os.path.join(hand_dir, f), dst))
+    print(f"{len(jobs)} clips to retarget with {args.workers} workers")
+    if not jobs:
+        return
+
+    try:
+        from tqdm import tqdm
+    except ImportError:
+        def tqdm(x, **k):
+            return x
+
+    errors = []
+    with mp.Pool(args.workers, initializer=_init, initargs=(args.urdf_dir,)) as pool:
+        for err in tqdm(pool.imap_unordered(_work, jobs, chunksize=4), total=len(jobs), desc="hands"):
+            if err:
+                errors.append(err)
+                print("[error]", err)
+    print(f"done, {len(jobs) - len(errors)} ok, {len(errors)} failed")
+    if errors:
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
